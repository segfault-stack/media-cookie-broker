{
  "name": "media-cookie-broker-remotion-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio --no-open",
    "typecheck": "tsc --noEmit",
    "render:mp4": "mkdir -p ../docs/demo && remotion render MediaCookieBrokerDemo ../docs/demo/media-cookie-broker-demo.mp4 --codec=h264 --crf=18 --overwrite",
    "render:webm": "mkdir -p ../docs/demo && remotion render MediaCookieBrokerDemo ../docs/demo/media-cookie-broker-demo.webm --codec=vp9 --crf=24 --overwrite",
    "render:poster": "mkdir -p ../docs/demo && remotion still MediaCookieBrokerDemo ../docs/demo/media-cookie-broker-demo-poster.png --frame=360 --overwrite",
    "render:gif": "mkdir -p ../docs/demo && ffmpeg -y -i ../docs/demo/media-cookie-broker-demo.mp4 -vf \"fps=15,scale=960:-1:flags=lanczos,split[s0][s1];[s0]palettegen=max_colors=192:stats_mode=diff[p];[s1][p]paletteuse=dither=bayer:bayer_scale=3:diff_mode=rectangle\" -loop 0 ../docs/demo/media-cookie-broker-demo.gif",
    "render": "npm run render:mp4 && npm run render:webm && npm run render:gif && npm run render:poster",
    "verify:media": "node scripts/inspect-media.mjs ../docs/demo/media-cookie-broker-demo.mp4 ../docs/demo/media-cookie-broker-demo.webm"
  },
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "@remotion/transitions": "4.0.515",
    "mediabunny": "1.55.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.515"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "typescript": "5.9.2"
  }
}

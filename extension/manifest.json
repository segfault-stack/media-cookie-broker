{
  "manifest_version": 3,
  "name": "Media Cookie Broker Publisher",
  "version": "0.3.0",
  "description": "Human control plane for provider/profile session health, recovery, and cookie publication.",
  "incognito": "spanning",
  "minimum_chrome_version": "120",
  "permissions": ["cookies", "storage", "alarms", "notifications", "tabs", "clipboardWrite"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.tiktok.com/*", "https://*.instagram.com/*",
    "https://*.x.com/*", "https://*.twitter.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"},
  "action": {"default_popup": "popup.html", "default_title": "Media Cookie Broker", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}},
  "options_page": "options.html"
}
